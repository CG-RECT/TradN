# TradN 环境变量示例。
# 使用前复制为项目根目录下的 .env，并将所有 change_ 开头的示例值替换为真实强密码。
# .env 已加入 Git 忽略规则，不要把真实密码、令牌密钥或生产连接信息提交到仓库。

# Docker Compose 项目名称，用于生成容器、网络和数据卷名称。
COMPOSE_PROJECT_NAME=tradn

# 后端服务端口，非 Docker 部署时由 Spring Boot 读取。
# 当前 Docker Compose 未把该变量传入 tradn-api，容器内固定使用默认端口 8080。
APP_PORT=8080

# MySQL 初始化数据库名称和业务账号。新环境不要把业务账号设置为 root。
MYSQL_DATABASE=tradn
MYSQL_USER=tradn

# MySQL 业务账号密码，tradn-api 使用该密码连接数据库。
MYSQL_PASSWORD=change_this_mysql_user_password

# MySQL root 初始密码，仅供 MySQL 容器初始化和健康检查使用，后端不会使用。
MYSQL_ROOT_PASSWORD=change_this_mysql_root_password

# Redis 访问密码，同时用于 Redis 服务启动和后端连接。
REDIS_PASSWORD=change_this_redis_password

# MinIO 管理账号、密码及 TradN 私有文件桶名称。
# MINIO_SECRET_KEY 应使用至少 16 位的随机强密码。
MINIO_ACCESS_KEY=tradnadmin
MINIO_SECRET_KEY=change_this_minio_secret_key
MINIO_BUCKET=tradn-files


# JWT 签名密钥和登录有效期。
# TOKEN_SECRET 应使用至少 32 字节的随机字符串；TOKEN_TTL 单位为秒，28800 表示 8 小时。
TOKEN_SECRET=change_this_token_secret_to_at_least_32_random_bytes
TOKEN_TTL=28800

# 首次启动时创建的管理员账号。
# 只有数据库中不存在同名账号时才会使用初始密码，密码长度不得少于 10 位。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_this_admin_password

# 单个上传文件和单次上传请求的最大大小，Spring Boot 与 Nginx 限制应保持一致。
UPLOAD_MAX_SIZE=20MB
